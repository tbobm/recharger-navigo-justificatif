<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example launchd job: runs `fetch` then `prefill` on the 10th of every
  month at 09:00, so the justificatif is ready well before most HR
  deadlines (commonly the 20th).

  The label "dev.tbobm.navigo-justificatif" is a reverse-DNS identifier —
  if you fork this, rename the file and the Label below to your own
  domain/handle instead (e.g. "dev.yourname.navigo-justificatif").

  Install (adjust REPO_PATH first; if you don't use mise, replace the
  ~/.local/share/mise/shims/uv paths below with `which uv`'s output):
    cp launchd/dev.tbobm.navigo-justificatif.plist \
       ~/Library/LaunchAgents/dev.tbobm.navigo-justificatif.plist
    launchctl load ~/Library/LaunchAgents/dev.tbobm.navigo-justificatif.plist

  Trigger it once by hand to test:
    launchctl start dev.tbobm.navigo-justificatif

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/dev.tbobm.navigo-justificatif.plist
    rm ~/Library/LaunchAgents/dev.tbobm.navigo-justificatif.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.tbobm.navigo-justificatif</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <!-- launchd doesn't source your shell profile, so `uv` on bare PATH
             won't resolve. This shim path is mise's stable symlink, which
             survives `uv` version upgrades (unlike the versioned path
             `which uv` reports in an interactive shell). -->
        <string>cd REPO_PATH &amp;&amp; ~/.local/share/mise/shims/uv run python navigo.py fetch &amp;&amp; ~/.local/share/mise/shims/uv run python navigo.py prefill</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>10</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/navigo-justificatif.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/navigo-justificatif.log</string>
</dict>
</plist>
